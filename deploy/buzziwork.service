# systemd *user* unit: ~/.config/systemd/user/buzziwork.service
# Needs `loginctl enable-linger $USER` so it runs without an open session.
[Unit]
Description=buzziwork Signal task bot

[Service]
WorkingDirectory=%h/.local/share/buzziwork
EnvironmentFile=%h/.config/buzziwork/env
Environment=SIGNAL_CLI=%h/.local/bin/signal-cli
ExecStart=%h/.local/bin/buzziwork
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
